<Sysmon schemaversion="4.90">
  <HashAlgorithms>sha256</HashAlgorithms>

  <EventFiltering>
    <ProcessCreate onmatch="include">
      <Image condition="end with">T1070_004_Test.exe</Image>
    </ProcessCreate>

    <FileDeleteDetected onmatch="include">
      <TargetFilename condition="end with">T1070_004_Test.exe</TargetFilename>
    </FileDeleteDetected>
  </EventFiltering>
</Sysmon>
